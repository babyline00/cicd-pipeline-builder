# Prisma SQLite database — ABSOLUTE path (required).
# The db:push script inlines this as $(pwd)/db/custom.db so the SQLite
# file lives inside this project's db/ folder and is isolated from the
# parent project.
DATABASE_URL=file:/home/z/my-project/apps/95-cicd-pipeline-builder/db/custom.db

# Optional: disable the real LLM and use the mock provider (offline dev / tests)
# PKC_DISABLE_LLM=1
# CICD_DISABLE_LLM=1
